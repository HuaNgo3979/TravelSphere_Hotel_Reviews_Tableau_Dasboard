      <table>
        <view>
          <datasources>
            <datasource caption='Final_2017_Hotel_Reviews' name='federated.1t7vs9t04bkr8e162uzwg0zogm7h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Minimum Hotel Reviews' datatype='integer' name='[Negative Topics AI Assisted Parameter]' param-domain-type='list' role='measure' type='quantitative' value='100'>
              <calculation class='tableau' formula='100' />
            </column>
            <column caption='Nationality Review Threshold' datatype='integer' name='[Positive Topics AI Assisted Parameter]' param-domain-type='list' role='measure' type='quantitative' value='300'>
              <calculation class='tableau' formula='300' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1t7vs9t04bkr8e162uzwg0zogm7h'>
            <column caption='Negative Issue Flag' datatype='integer' name='[Calculation_2597594593452036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Negative_No_Issue_Flag] = 0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Negative Issue %' datatype='real' name='[Calculation_2597594593656837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2597594593452036]) / COUNT([Reviewer_Score])' />
            </column>
            <column caption='Hotel Average Score' datatype='real' name='[Calculation_2597594594275337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Hotel_Name] : AVG([Reviewer_Score]) }' />
            </column>
            <column caption='Nationality Review Count' datatype='integer' name='[Calculation_2597594594328586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Reviewer_Nationality] : COUNT([Reviewer_Score]) }' />
            </column>
            <column caption='Hotel Eligible Flag' datatype='boolean' name='[Calculation_2597594743513100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [Hotel_Name] : COUNT([Reviewer_Score]) } &gt;= [Parameters].[Negative Topics AI Assisted Parameter]' />
            </column>
            <column caption='Satisfaction Performance Band' datatype='string' name='[Calculation_2597594939138066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2597594594275337] &gt;= 8.5 THEN &quot;High Satisfaction&quot;&#10;ELSEIF [Calculation_2597594594275337] &gt;= 8.0 THEN &quot;Moderate Satisfaction&quot;&#10;ELSE &quot;Low Satisfaction&quot;&#10;END' />
            </column>
            <column caption='Risk Flag' datatype='string' name='[Calculation_2597594979860499]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2597594593656837] &gt;= 0.60 THEN &quot;High Risk&quot;&#10;ELSEIF [Calculation_2597594593656837] &gt;= 0.50 THEN &quot;Moderate Risk&quot;&#10;ELSE &quot;Low Risk&quot;&#10;END' />
            </column>
            <column caption='Keep Nationality by Review Threshold' datatype='boolean' name='[Calculation_2597595183665178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2597594594328586] &gt;= [Parameters].[Positive Topics AI Assisted Parameter]' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Hotel Name' datatype='string' name='[Hotel_Name]' role='dimension' type='nominal' />
